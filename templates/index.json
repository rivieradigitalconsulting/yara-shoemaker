          }
        },
        "column_2": {
          "type": "column",
          "settings": {
            "image_max_width": 50,
            "title": "INDIVIDUALITY",
            "subheading": "<p>No two women are alike. Every couture creation is developed to reflect her character, her proportions, and the way she moves through the world.</p>",
            "text_max_width": 36,
            "link": "",
            "link_text": "Read more"
          }
        },
        "column_3": {
          "type": "column",
          "settings": {
            "image_max_width": 50,
            "title": "RESPONSIBILITY",
            "subheading": "<p>True luxury respects both beauty and the future. Every decision reflects our commitment to thoughtful design, ethical craftsmanship, and lasting value.</p>",
            "text_max_width": 36,
            "link": "",
            "link_text": "Read more"
          }
        }
