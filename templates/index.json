    "image_with_text_split_1": {
      "type": "image-with-text-split",
      "settings": {
        "enable_animation": true,
        "feature_image": "shopify://shop_images/Screenshot_2024-07-21_at_3.26.19_PM.png",
        "feature_link": "",
        "feature_description": "<p>THE ATELIER, WHEREVER YOU ARE</p>",
        "feature_text_color": "#313131",
        "background_color": "#f3f3f3",
        "color_background_gradient": "",
        "feature_alignment": "center_bottom",
        "overlay_image": "shopify://shop_images/Screenshot_2023-08-02_at_2.59.49_PM.png",
        "link": "",
        "image_text": "<p>The couture experience should never be limited by geography.</p><p>Whether welcoming clients to our Paris showroom or traveling internationally for private consultations and fittings, we bring the same level of precision, discretion, and personal attention wherever the journey begins.</p>",
        "text_color": "#363636",
