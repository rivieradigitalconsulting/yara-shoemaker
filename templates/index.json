    "image_hero_mJKM48": {
      "type": "image-hero",
      "blocks": {
        "heading_3recbW": {
          "type": "heading",
          "settings": {
            "heading": "THE ART OF FIT",
            "heading_text_size": 32,
            "text_max_width": 40
          }
        },
        "subheading_34dUdw": {
          "type": "subheading",
          "settings": {
            "subheading": "<p>A couture garment should never ask a woman to change herself.</p><p>It should adapt to her with extraordinary precision, honoring her proportions, her movement, and her individuality until it feels as though it has always belonged to her.</p><p>Every fitting is a dialogue between designer, artisan, and client, refining every line until beauty and comfort become one.</p><p><br/></p><p>This is something almost no couture house explains.</p><p>Yet it’s one of your biggest strengths.</p>",
            "subheading_text_size": 14,
            "text_max_width": 41
          }
        }
      },
      "block_order": [
        "heading_3recbW",
        "subheading_34dUdw"
